# Repository-wide reference for local environment variables.
#
# Nothing reads this file directly: Cloudflare Workers get their local vars
# from each app's wrangler.jsonc (apps/*/wrangler.jsonc), and the dashboard
# reads Vite-exposed VITE_-prefixed vars from apps/dashboard/.env.example.
# This file exists so the full picture is in one place. Never commit a real
# .env with secrets.

APP_ENV=development
DASHBOARD_URL=http://localhost:5173
API_URL=http://localhost:8787
DELIVERY_URL=http://localhost:8788
IMAGERYX_API_KEY=imgx_dev_local

# Provider selection (see packages/providers/src/config/provider-config.schema.ts).
# Local/default: filesystem storage, deterministic mock transformations — no
# Cloudflare or Cloudinary account needed for any command in this phase.
STORAGE_PROVIDER=local
TRANSFORMATION_PROVIDER=mock
LOCAL_STORAGE_PATH=.local/storage

# Future configuration (not active while STORAGE_PROVIDER=local / TRANSFORMATION_PROVIDER=mock).
# R2 needs no extra vars here — it's configured as a binding in wrangler.jsonc.
# STORAGE_PROVIDER=r2
# TRANSFORMATION_PROVIDER=cloudflare
# ADVANCED_TRANSFORMATION_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
