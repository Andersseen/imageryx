# Repository-wide reference for local environment variables.
#
# Nothing reads this file directly: Cloudflare Workers get their local
# non-secret vars from each app's wrangler.jsonc (apps/*/wrangler.jsonc)
# and their local secrets (IMAGERYX_API_KEY, DOWNLOAD_SIGNING_SECRET) from
# each app's .dev.vars (git-ignored — copy from apps/*/.dev.vars.example),
# the dashboard reads Vite-exposed VITE_-prefixed vars from
# apps/dashboard/.env.example, and the dashboard's server-side API proxy
# reads process.env directly (see apps/dashboard/.env.example's second
# section). This file exists so the full picture is in one place. Never
# commit a real .env with secrets.

APP_ENV=development

DASHBOARD_URL=http://localhost:5173
API_URL=http://localhost:8787
DELIVERY_URL=http://localhost:8788

# Every /v1/* API route requires this as a Bearer token (see
# apps/api-worker/src/middleware/auth.ts). The dashboard's /dev-flow page
# never holds this in browser code — see README's "Authentication" section.
IMAGERYX_API_KEY=imgx_dev_local

# Provider selection (see packages/providers/src/config/provider-config.schema.ts).
# STORAGE_PROVIDER=r2 here means the Miniflare-simulated local R2 bucket that
# `wrangler dev` (and the seed script) provision automatically — it needs no
# real Cloudflare account or credentials. "local" (LocalStorageProvider,
# filesystem-backed) is Node-only tooling and cannot run inside a Worker —
# see context.md's "Local-mode architecture" note for why Phase 3 moved off
# it for the Workers themselves.
STORAGE_PROVIDER=r2
# Repository default is "mock" so tests and fresh clones work without Cloudinary secrets.
# For real personal use, copy this file to .env, set TRANSFORMATION_PROVIDER=cloudinary,
# and fill in CLOUDINARY_* below — then also update apps/*/.dev.vars.
TRANSFORMATION_PROVIDER=mock
ADVANCED_TRANSFORMATION_PROVIDER=

# Only read by Node-only tooling now (not by any Worker) — kept for
# @imageryx/providers/node's LocalStorageProvider, still used by some
# package-level unit tests.
LOCAL_STORAGE_PATH=.local/storage

MAX_UPLOAD_SIZE_MB=25
ASSET_RECOVERY_DAYS=30
PROCESSING_MAX_ATTEMPTS=3
# "queue" (default): api-worker publishes to PROCESSING_QUEUE, processing-worker
# consumes it — real Cloudflare Queues, locally simulated via a shared
# `--persist-to` directory (see context.md). "inline-local": api-worker runs
# the exact same job-processing function directly inside `waitUntil`,
# bypassing Queues entirely — a documented fallback if local multi-worker
# Queue delivery isn't available in your environment.
PROCESSING_MODE=queue

# A non-production development secret — never reuse this value for a real
# deployment. Used to sign short-lived private-download tokens (see
# apps/api-worker/src/routes/v1/assets.ts's download-url route and
# apps/delivery-worker/src/routes/download.ts).
DOWNLOAD_SIGNING_SECRET=replace-with-local-development-secret

# Cloudinary is the default transformation provider. The Cloudinary adapter
# performs real upload/eager/fetch calls when these three variables are set.
# Keep them empty only if you explicitly set TRANSFORMATION_PROVIDER=mock.
# The Cloudflare Images adapter still throws until wired to real HTTP.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_TOKEN=

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
