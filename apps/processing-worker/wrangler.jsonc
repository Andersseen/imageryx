{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imageryx-processing-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "vars": {
    "APP_ENV": "development",
    "STORAGE_PROVIDER": "r2",
    // Dev default is "mock" so the Worker boots without Cloudinary secrets.
    // Override this in your local .dev.vars (see .dev.vars.example) to use
    // Cloudinary for real transformations during local development.
    "TRANSFORMATION_PROVIDER": "mock",
    "DASHBOARD_URL": "http://localhost:5173",
    "PROCESSING_MAX_ATTEMPTS": "3",
    "CLOUDINARY_CLOUD_NAME": "",
    "CLOUDINARY_API_KEY": "",
    "CLOUDINARY_API_SECRET": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imageryx-db",
      "database_id": "3c3a3b44-768f-4162-8e18-59f862ddbc49",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSET_STORAGE",
      "bucket_name": "imageryx-storage"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "imageryx-processing-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "production": {
      // Without an explicit name, `wrangler deploy --env production`
      // publishes as "imageryx-processing-worker-production".
      "name": "imageryx-processing-worker",
      "vars": {
        "APP_ENV": "production",
        "STORAGE_PROVIDER": "r2",
        "TRANSFORMATION_PROVIDER": "cloudinary",
        "DASHBOARD_URL": "https://imageryx-dashboard.pages.dev",
        "PROCESSING_MAX_ATTEMPTS": "3"
        // CLOUDINARY_* are deliberately absent here. Vars and secrets share one binding
        // namespace on a Worker, and the config's vars are authoritative on every deploy —
        // listing `"CLOUDINARY_API_SECRET": ""` here would overwrite the real secret set with
        // `wrangler secret put` with an empty string on the next deploy, silently breaking
        // every transformation. They stay in the top-level (development) `vars` only because
        // `wrangler types` derives the `Env` interface from that block; production values come
        // from `wrangler secret put --env production`.
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "imageryx-db",
          "database_id": "3c3a3b44-768f-4162-8e18-59f862ddbc49",
          "migrations_dir": "../../packages/database/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSET_STORAGE",
          "bucket_name": "imageryx-storage"
        }
      ],
      "queues": {
        "producers": [{ "binding": "PROCESSING_QUEUE", "queue": "imageryx-processing-queue" }],
        "consumers": [
          {
            "queue": "imageryx-processing-queue",
            "max_batch_size": 10,
            "max_batch_timeout": 5
          }
        ]
      }
    }
  }
}
