{
  "name": "@imageryx/processing-worker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Imageryx Processing Worker - consumes the processing Queue and runs metadata inspection and mock variant generation jobs.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./jobs": {
      "types": "./src/jobs/process-job.ts",
      "default": "./src/jobs/process-job.ts"
    },
    "./jobs/deps": {
      "types": "./src/lib/env.ts",
      "default": "./src/lib/env.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev --port 8789 --inspector-port 9231 --persist-to ../../.wrangler-state",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --env production",
    "lint": "eslint .",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@imageryx/contracts": "workspace:*",
    "@imageryx/database": "workspace:*",
    "@imageryx/image-core": "workspace:*",
    "@imageryx/providers": "workspace:*",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@imageryx/eslint-config": "workspace:*",
    "@imageryx/test-utils": "workspace:*",
    "@imageryx/typescript-config": "workspace:*",
    "@vitest/coverage-istanbul": "^4.1.10",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
}
