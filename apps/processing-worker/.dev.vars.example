# Local-only secrets for `wrangler dev` (Miniflare). Copy this file to
# `.dev.vars` (git-ignored) — never commit real values here or in
# wrangler.jsonc. Production values are set with `wrangler secret put`
# (see README's "Deployment" section).

# Default transformation provider is Cloudinary. Keep these placeholders
# only if you explicitly override TRANSFORMATION_PROVIDER=mock.
TRANSFORMATION_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
