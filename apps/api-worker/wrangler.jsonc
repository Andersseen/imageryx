{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imageryx-api-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "vars": {
    "APP_ENV": "development",
    "STORAGE_PROVIDER": "r2",
    "TRANSFORMATION_PROVIDER": "mock",
    "DASHBOARD_URL": "http://localhost:5173",
    "DELIVERY_URL": "http://localhost:8788",
    "LOCAL_STORAGE_PATH": "../../.local/storage",
    "IMAGERYX_API_KEY": "imgx_dev_local",
    "MAX_UPLOAD_SIZE_MB": "25",
    "ASSET_RECOVERY_DAYS": "30",
    "PROCESSING_MAX_ATTEMPTS": "3",
    "PROCESSING_MODE": "queue",
    "DOWNLOAD_SIGNING_SECRET": "replace-with-local-development-secret"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imageryx-db",
      "database_id": "3c3a3b44-768f-4162-8e18-59f862ddbc49",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSET_STORAGE",
      "bucket_name": "imageryx-storage"
    }
  ],
  "queues": {
    "producers": [{ "binding": "PROCESSING_QUEUE", "queue": "imageryx-processing-queue" }]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "production": {
      // Without an explicit name, `wrangler deploy --env production`
      // publishes as "imageryx-api-worker-production".
      "name": "imageryx-api-worker",
      // FIXME(security): IMAGERYX_API_KEY and DOWNLOAD_SIGNING_SECRET are
      // real secrets and must not ship as plaintext vars in a public repo —
      // as written, the production API is protected by a key anyone can
      // read. Move both to `wrangler secret put <NAME> --env production`
      // (needs a `.dev.vars` story for local dev first — see README).
      "vars": {
        "APP_ENV": "production",
        "STORAGE_PROVIDER": "r2",
        "TRANSFORMATION_PROVIDER": "mock",
        "DASHBOARD_URL": "https://imageryx-dashboard.pages.dev",
        "DELIVERY_URL": "https://imageryx-delivery-worker.workers.dev",
        "LOCAL_STORAGE_PATH": "../../.local/storage",
        "IMAGERYX_API_KEY": "imgx_dev_local",
        "MAX_UPLOAD_SIZE_MB": "25",
        "ASSET_RECOVERY_DAYS": "30",
        "PROCESSING_MAX_ATTEMPTS": "3",
        "PROCESSING_MODE": "queue",
        "DOWNLOAD_SIGNING_SECRET": "replace-with-local-development-secret"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "imageryx-db",
          "database_id": "3c3a3b44-768f-4162-8e18-59f862ddbc49",
          "migrations_dir": "../../packages/database/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSET_STORAGE",
          "bucket_name": "imageryx-storage"
        }
      ],
      "queues": {
        "producers": [{ "binding": "PROCESSING_QUEUE", "queue": "imageryx-processing-queue" }]
      }
    }
  }
}
