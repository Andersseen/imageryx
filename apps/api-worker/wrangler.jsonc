{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imageryx-api-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  // IMAGERYX_API_KEY and DOWNLOAD_SIGNING_SECRET are secrets, not plain
  // vars — even the dev defaults live in .dev.vars (git-ignored), never
  // here. Copy .dev.vars.example to .dev.vars to run this Worker locally.
  "vars": {
    "APP_ENV": "development",
    "STORAGE_PROVIDER": "r2",
    "TRANSFORMATION_PROVIDER": "mock",
    "DASHBOARD_URL": "http://localhost:5173",
    "DELIVERY_URL": "http://localhost:8788",
    "LOCAL_STORAGE_PATH": "../../.local/storage",
    "MAX_UPLOAD_SIZE_MB": "25",
    "ASSET_RECOVERY_DAYS": "30",
    "PROCESSING_MAX_ATTEMPTS": "3",
    "PROCESSING_MODE": "queue"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imageryx-db",
      "database_id": "3c3a3b44-768f-4162-8e18-59f862ddbc49",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSET_STORAGE",
      "bucket_name": "imageryx-storage"
    }
  ],
  "queues": {
    "producers": [{ "binding": "PROCESSING_QUEUE", "queue": "imageryx-processing-queue" }]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "production": {
      // Without an explicit name, `wrangler deploy --env production`
      // publishes as "imageryx-api-worker-production".
      "name": "imageryx-api-worker",
      // IMAGERYX_API_KEY and DOWNLOAD_SIGNING_SECRET are real secrets and
      // must never be plaintext vars here. Set them once per environment
      // with `wrangler secret put <NAME> --env production` (see README's
      // "Deployment" section) — they persist in Cloudflare across deploys
      // and are not reset by `wrangler deploy`.
      "vars": {
        "APP_ENV": "production",
        "STORAGE_PROVIDER": "r2",
        "TRANSFORMATION_PROVIDER": "mock",
        "DASHBOARD_URL": "https://imageryx-dashboard.pages.dev",
        "DELIVERY_URL": "https://imageryx-delivery-worker.workers.dev",
        "LOCAL_STORAGE_PATH": "../../.local/storage",
        "MAX_UPLOAD_SIZE_MB": "25",
        "ASSET_RECOVERY_DAYS": "30",
        "PROCESSING_MAX_ATTEMPTS": "3",
        "PROCESSING_MODE": "queue"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "imageryx-db",
          "database_id": "3c3a3b44-768f-4162-8e18-59f862ddbc49",
          "migrations_dir": "../../packages/database/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSET_STORAGE",
          "bucket_name": "imageryx-storage"
        }
      ],
      "queues": {
        "producers": [{ "binding": "PROCESSING_QUEUE", "queue": "imageryx-processing-queue" }]
      }
    }
  }
}
