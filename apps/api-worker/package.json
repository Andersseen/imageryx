{
  "name": "@imageryx/api-worker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Imageryx API Worker - health, service info, and (in later phases) upload/transformation routes.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --inspector-port 9229 --persist-to ../../.wrangler-state",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --env production",
    "lint": "eslint .",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply imageryx-db --local --persist-to ../../.wrangler-state",
    "db:migrate:e2e": "wrangler d1 migrations apply imageryx-db --local --persist-to ../../.wrangler-state-e2e",
    "db:status:local": "wrangler d1 migrations list imageryx-db --local --persist-to ../../.wrangler-state",
    "db:migrate:production": "wrangler d1 migrations apply imageryx-db --remote --env production",
    "db:status:production": "wrangler d1 migrations list imageryx-db --remote --env production"
  },
  "dependencies": {
    "@imageryx/contracts": "workspace:*",
    "@imageryx/database": "workspace:*",
    "@imageryx/image-core": "workspace:*",
    "@imageryx/processing-worker": "workspace:*",
    "@imageryx/providers": "workspace:*",
    "hono": "^4.12.32",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@imageryx/delivery-worker": "workspace:*",
    "@imageryx/eslint-config": "workspace:*",
    "@imageryx/test-utils": "workspace:*",
    "@imageryx/typescript-config": "workspace:*",
    "@vitest/coverage-istanbul": "^4.1.10",
    "miniflare": "^4.20260722.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
}
