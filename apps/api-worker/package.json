{
  "name": "@imageryx/api-worker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Imageryx API Worker - health, service info, and (in later phases) upload/transformation routes.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --inspector-port 9229",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --env production",
    "lint": "eslint .",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply imageryx-db --local",
    "db:status:local": "wrangler d1 migrations list imageryx-db --local",
    "db:migrate:production": "wrangler d1 migrations apply imageryx-db --remote --env production",
    "db:status:production": "wrangler d1 migrations list imageryx-db --remote --env production"
  },
  "dependencies": {
    "@imageryx/contracts": "workspace:*",
    "@imageryx/database": "workspace:*",
    "@imageryx/image-core": "workspace:*",
    "@imageryx/providers": "workspace:*",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@imageryx/eslint-config": "workspace:*",
    "@imageryx/test-utils": "workspace:*",
    "@imageryx/typescript-config": "workspace:*",
    "typescript": "^6.0.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
