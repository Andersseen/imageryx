{
  "name": "@imageryx/self-hosted",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Minimal Node + SQLite runtime proving the Imageryx backend architecture runs outside Cloudflare — not the complete self-hosted product yet (see ROADMAP.md's Self-hosting Phase A/B/C/D).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@imageryx/api-worker": "workspace:*",
    "@imageryx/contracts": "workspace:*",
    "@imageryx/database": "workspace:*",
    "hono": "^4.12.32",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@imageryx/eslint-config": "workspace:*",
    "@imageryx/typescript-config": "workspace:*",
    "@types/node": "^22.9.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
