# Copy to .env.local for local overrides (git-ignored). None of these are read via a `.env`
# loader today — plain `process.env`, set on the shell or by your process manager — this file
# only documents the contract. See README.md's "Self-hosting" section and context.md's
# "Self-host Phase A decisions and limitations" for the full detail.
#
# Deliberately does NOT need any of: CLOUDFLARE_ACCOUNT_ID, R2, Queues, Cloudinary, DevAuth.

RUNTIME=node
DATABASE_PROVIDER=sqlite

# Repo-root-relative for local dev (resolved against the repo root, not the current directory);
# absolute for a real self-host deployment, e.g. DATABASE_PATH=/data/imageryx.db
DATABASE_PATH=.local/self-hosted/imageryx.db

APP_ENV=development
PORT=8790
