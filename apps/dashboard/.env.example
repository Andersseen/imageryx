# Copy to .env.local for local overrides. Vite only exposes VITE_-prefixed
# vars to client code (see src/app/core/env/dashboard-env.ts).
VITE_APP_ENV=development
VITE_API_URL=http://localhost:8787
VITE_DELIVERY_URL=http://localhost:8788
VITE_PROCESSING_URL=http://localhost:8789

# Server-side only (Nitro/Node — never VITE_-prefixed, never bundled into
# client JS). Used exclusively by src/server/routes/proxy/[...path].ts, the
# proxy that injects the API key for dashboard API calls — see README's
# "Authentication" section. Both already default sensibly in code, so this
# file (and even a real .env.local) is optional for local development.
API_URL=http://localhost:8787
IMAGERYX_API_KEY=imgx_dev_local

# ---------------------------------------------------------------------------
# DevAuth (OAuth 2.1 / OIDC sign-in) — server-side only.
#
# Copy this file to `.env` in this directory (git-ignored) and fill in the real
# values. `.env` specifically, not `.env.local`: Nitro's dev server is what
# loads these into `process.env`, and it reads `.env`. Nothing here is
# VITE_-prefixed, so none of it can reach client JS.
#
# Unlike the two variables above, these have NO defaults in code — a missing one
# makes /proxy/auth/login render "Sign-in is not configured" rather than
# silently sending the browser somewhere unintended.
# ---------------------------------------------------------------------------

# The DevAuth issuer. Endpoint paths are read from its discovery document at
# {DEV_AUTH_URL}/.well-known/openid-configuration — never hardcoded here.
# Local DevAuth runs on 8786 so it does not collide with Imageryx's api-worker
# on 8787. Use https://auth-devflare.andersseen.dev only after the production
# DevAuth client and secret have been registered.
DEV_AUTH_URL=http://localhost:8786

# Must match the client registered in DevAuth's OAUTH_CLIENTS.
DEV_AUTH_CLIENT_ID=imageryx

# Confidential ("web") client secret, issued by DevAuth into its
# OAUTH_CLIENT_SECRETS. Used only in the server-side token exchange.
# NEVER commit a real value.
DEV_AUTH_CLIENT_SECRET=replace-with-the-secret-devauth-issued

# Matched byte for byte by DevAuth — no wildcards, no prefixes, no trailing
# slash you did not intend. Must be exactly what is registered.
# Local: http://localhost:5173/proxy/auth/callback
DEV_AUTH_REDIRECT_URI=http://localhost:5173/proxy/auth/callback

# Optional. Defaults to "openid profile email". `offline_access` is deliberately
# NOT requested: this app never calls DevAuth again after the callback, so a
# refresh token would be a stored credential with no consumer.
# DEV_AUTH_SCOPE=openid profile email

# Signs Imageryx's OWN session cookie (HMAC-SHA256). Any long random string;
# `pnpm key:generate` produces a suitable one. Rotating it invalidates every
# existing session, which is the intended way to sign everyone out.
# NEVER commit a real value.
SESSION_SECRET=replace-with-a-long-random-local-development-secret
