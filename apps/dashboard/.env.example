# Copy to .env.local for local overrides. Vite only exposes VITE_-prefixed
# vars to client code (see src/app/core/env/dashboard-env.ts).
VITE_APP_ENV=development
VITE_API_URL=http://localhost:8787
VITE_DELIVERY_URL=http://localhost:8788
VITE_PROCESSING_URL=http://localhost:8789

# Server-side only (Nitro/Node — never VITE_-prefixed, never bundled into
# client JS). Used exclusively by src/server/routes/api/[...path].ts, the
# proxy that injects the API key for the /dev-flow page — see README's
# "Authentication" section. Both already default sensibly in code, so this
# file (and even a real .env.local) is optional for local development.
API_URL=http://localhost:8787
IMAGERYX_API_KEY=imgx_dev_local
