{
  "name": "@imageryx/dashboard",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Imageryx dashboard - Analog + Angular 21 (zoneless) application shell.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @imageryx/api-worker run db:migrate:e2e && playwright test",
    "test:a11y": "pnpm --filter @imageryx/api-worker run db:migrate:e2e && playwright test e2e/accessibility.spec.ts",
    "test:e2e:ui": "pnpm --filter @imageryx/api-worker run db:migrate:e2e && playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "deploy": "wrangler pages deploy dist/analog/public --project-name imageryx-dashboard --branch main"
  },
  "dependencies": {
    "@analogjs/router": "^2.6.4",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@imageryx/angular": "workspace:*",
    "@imageryx/contracts": "workspace:*",
    "@imageryx/providers": "workspace:*",
    "@imageryx/sdk": "workspace:*",
    "@voltui/components": "^1.0.0",
    "angular-movement": "^0.7.0",
    "h3": "^1.15.11",
    "lumen-icons": "^0.2.0",
    "quartz-headless": "^0.0.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.6.4",
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.12.1",
    "@imageryx/eslint-config": "workspace:*",
    "@imageryx/test-utils": "workspace:^",
    "@imageryx/typescript-config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
}
