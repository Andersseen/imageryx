{
  "name": "imageryx",
  "private": true,
  "description": "Imageryx monorepo - open, provider-independent image delivery and transformation platform.",
  "license": "MIT",
  "scripts": {
    "dev": "node tooling/scripts/dev-orchestrate.mjs",
    "dev:dashboard": "turbo run dev --filter=@imageryx/dashboard",
    "dev:web": "turbo run dev --filter=@imageryx/web",
    "dev:api": "turbo run dev --filter=@imageryx/api-worker",
    "dev:delivery": "turbo run dev --filter=@imageryx/delivery-worker",
    "dev:processing": "turbo run dev --filter=@imageryx/processing-worker",
    "dev:workers": "node tooling/scripts/dev-orchestrate.mjs --workers-only",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=!@imageryx/api-worker --filter=!@imageryx/delivery-worker --filter=!@imageryx/processing-worker",
    "test:workers": "turbo run test --filter=@imageryx/api-worker --filter=@imageryx/delivery-worker --filter=@imageryx/processing-worker",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:a11y": "turbo run test:a11y",
    "test:coverage": "turbo run test:coverage",
    "cloudinary:health": "pnpm --filter @imageryx/providers run test -- --testNamePattern 'CloudinaryProvider real-account health check'",
    "e2e:install": "pnpm --filter @imageryx/dashboard run e2e:install",
    "check": "turbo run lint typecheck test build",
    "check:full": "pnpm check && pnpm test:integration && pnpm test:e2e && pnpm test:a11y && pnpm test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,html,json,md,yml,yaml}\" --ignore-unknown",
    "format:check": "prettier --check \"**/*.{ts,tsx,html,json,md,yml,yaml}\" --ignore-unknown",
    "clean": "turbo run clean && rm -rf node_modules",
    "verify:structure": "node tooling/scripts/verify-workspace-structure.mjs",
    "key:generate": "node tooling/scripts/generate-key.mjs",
    "deploy:validate": "node tooling/scripts/deploy-validate.mjs",
    "deploy": "node tooling/scripts/deploy.mjs",
    "smoke:production": "node tooling/scripts/smoke-production.mjs",
    "setup:local": "node tooling/scripts/setup-local.mjs",
    "db:migrate:local": "pnpm --filter @imageryx/api-worker run db:migrate:local",
    "db:seed:local": "pnpm --filter @imageryx/database run seed:local",
    "db:reset:local": "node tooling/scripts/db-reset-local.mjs",
    "db:status:local": "pnpm --filter @imageryx/api-worker run db:status:local",
    "storage:prepare:local": "node tooling/scripts/storage-prepare-local.mjs",
    "storage:reset:local": "node tooling/scripts/storage-reset-local.mjs",
    "processing:run-local": "pnpm --filter @imageryx/scripts run processing:run-local",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status"
  },
  "devDependencies": {
    "@changesets/cli": "^2",
    "@types/node": "^22.9.4",
    "prettier": "^3.7.4",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  }
}
