  },
  "devDependencies": {
    "@imageryx/eslint-config": "workspace:*",
    "@imageryx/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
