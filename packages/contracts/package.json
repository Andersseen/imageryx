{
  "name": "@imageryx/contracts",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Shared Zod schemas and TypeScript contracts (domain, request/response, and health-check shapes) between Imageryx apps.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
