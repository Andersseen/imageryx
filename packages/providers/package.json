{
  "name": "@imageryx/providers",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Storage and transformation provider interfaces and implementations (local filesystem, R2, mock transform, Cloudflare Images mapping, Cloudinary mapping) for Imageryx.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@imageryx/contracts": "workspace:*",
    "@imageryx/image-core": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@imageryx/eslint-config": "workspace:*",
    "@imageryx/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
